<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="redirect_form">
        <div class="o_tpp_redirect_wrapper">
            <div class="o_tpp_redirect_content">
                <img class="o_tpp_redirect_logo" t-att-src="'/tpp-odoomodule/static/description/tropipaylogo.png'" alt="TropiPay"/>
                <div class="o_tpp_redirect_text">
                    <t>Conectando con TropiPay…</t>
                </div>
            </div>
            <form t-att-action="api_url" method="post">
                <input type="hidden" name="csrf_token"
                       t-att-value="request.csrf_token()"/>
            </form>
        </div>
    </template>

</odoo>
