<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="redirect_form">
        <div class="o_tpp_redirect_wrapper">
            <div class="o_tpp_redirect_content">
                <img class="o_tpp_redirect_logo" t-att-src="'/tpp-odoomodule/static/description/tropipaylogo.png'" alt="TropiPay"/>
                <div class="o_tpp_redirect_text">
                    <t>Conectando con TropiPay…</t>
                </div>
            </div>
            <form t-att-action="api_url" method="post">
                <input type="hidden" name="csrf_token"
                       t-att-value="request.csrf_token()"/>
            </form>
            <!-- Estilos mínimos inline para asegurar visibilidad inmediata -->
            <style>
            .o_tpp_redirect_wrapper { display:flex; align-items:center; justify-content:center; min-height:50vh; }
            .o_tpp_redirect_content { text-align:center; }
            .o_tpp_redirect_logo { height: 96px; width:auto; margin-bottom: 12px; }
            .o_tpp_redirect_text { font-size: 16px; color: #555; }
            </style>
            <!-- Enviar el formulario automáticamente tras un pequeño retraso -->
            <script type="text/javascript"><![CDATA[
            (function(){
                setTimeout(function(){
                    var form = document.currentScript && document.currentScript.previousElementSibling;
                    if(form && form.tagName === 'FORM') { form.submit(); }
                    else {
                        var f = document.querySelector('.o_tpp_redirect_wrapper form');
                        if (f) { f.submit(); }
                    }
                }, 400);
            })();
            ]]></script>
        </div>
    </template>

</odoo>
