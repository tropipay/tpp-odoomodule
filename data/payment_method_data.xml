<odoo>
    <!-- Define a new payment method code specific for TropiPay in Odoo 17 -->
    <record id="payment_method_tpp_card" model="payment.method">
        <field name="name">TropiPay</field>
        <field name="code">tpp_card</field>
        <field name="sequence" eval="50"/>
        <field name="image" type="base64" file="tpp-odoomodule/static/description/tropipaylogo.png"/>
    </record>
</odoo>
